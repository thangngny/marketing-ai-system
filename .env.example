# Runtime mode: mock | sandbox | production
MARKETING_ENVIRONMENT=mock
MARKETING_SAFE_DRY_RUN=true
MARKETING_DATA_DIR=
MARKETING_LOG_DIR=

# Zoho CRM OAuth
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Microsoft Graph OAuth
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_GRAPH_ACCESS_TOKEN=
MS_REDIRECT_URI=http://localhost:8765/oauth/microsoft/callback

# Apollo
APOLLO_API_KEY=

# LinkedIn OAuth
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REDIRECT_URI=http://localhost:8765/oauth/linkedin/callback

# YouTube / Google OAuth
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Meta Marketing API
META_APP_ID=
META_APP_SECRET=
